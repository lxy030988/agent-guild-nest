// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User 模型 - 支持 Web3 登录
model User {
  id            Int      @id @default(autoincrement())
  walletAddress String   @unique // 钱包地址（主要登录凭证）
  email         String?  // 可选邮箱
  name          String?  // 用户名
  nonce         String?  // 用于签名验证的随机数
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agents        Agent[]  // 拥有的 Agents
  publishedJobs Job[]    @relation("JobOwner") // 发布的 Jobs（第三阶段）
  
  // 第四阶段：Wallet 和 Bills
  transactionsFrom  Transaction[] @relation("TransactionFrom")
  transactionsTo    Transaction[] @relation("TransactionTo")
  bills             Bill[]
  
  // 第五阶段：DAO 争议解决
  createdDisputes   Dispute[]     @relation("DisputeCreator")  // 创建的争议
  votes             Vote[]        // 投票记录
}



// ============================================
// Agent 管理模块（第二阶段）
// ============================================

// Agent 分类枚举
enum AgentCategory {
  PRODUCTIVITY_TOOLS
  CREATIVE_ASSISTANTS
  DEVELOPER_TOOLS
  OTHERS
}

// Agent 状态
enum AgentStatus {
  DRAFT       // 草稿（第二阶段）
  ACTIVE      // 已发布（第二阶段）
  MINTED      // 已铸造 NFT（第四阶段）
  PAUSED      // 已暂停
  ARCHIVED    // 已归档
}


// ============================================
// Jobs 市场模块（第三阶段）
// ============================================

// Job 分类枚举
enum JobCategory {
  CODE_REVIEW
  CONTENT_CREATION
  DATA_ANALYSIS
  TRANSLATION
  TESTING
  RESEARCH
  OTHER
}

// Job 状态
enum JobStatus {
  OPEN           // 待匹配
  MATCHED        // 已匹配 Agent
  IN_PROGRESS    // 执行中
  SUBMITTED      // 已提交结果
  COMPLETED      // 已完成
  CANCELLED      // 已取消
  DISPUTED       // 有争议（第五阶段）
  RESOLVED_COMPLETED // 争议解决-已支付
  RESOLVED_CANCELLED // 争议解决-已退款
}

// Job 匹配模式
enum MatchingMode {
  SMART         // 智能匹配（自动分配）
  MANUAL        // 手动选择（从推荐中选）
  APPLICATION   // 申请制（Agent 主动申请）
  OPEN_MARKET   // 开放市场（推荐 + 申请）
}

// Job 主模型
model Job {
  id          Int      @id @default(autoincrement())
  
  // 基本信息
  title       String
  description String   @db.Text
  category    JobCategory
  tags        String[]
  
  // 需求定义
  requiredCapabilities String[] // 需要的 Agent 能力
  inputData   Json                // 任务输入数据
  expectedOutput String? @db.Text // 期望输出说明
  
  // 财务信息
  budget      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USDC")
  escrowAmount Decimal @db.Decimal(10, 2) // 托管金额（预留第四阶段）
  
  // 时间信息
  deadline    DateTime?
  estimatedDuration Int? // 预计耗时（分钟）
  
  // 状态管理
  status      JobStatus @default(OPEN)
  matchingMode MatchingMode @default(SMART) // 匹配模式
  
  // 智能合约集成（链上字段）
  chainJobId      String?  @unique // 链上任务 ID（字符串存储，避免 BigInt 序列化问题）
  chainTxHash     String?           // 创建任务的交易哈希
  chainDeadline   String?           // 链上截止时间（Unix 时间戳，字符串存储）
  chainStatus     Int?              // 链上状态（用于对账）
  chainBudget     String?           // 链上托管金额（Wei，字符串存储）
  
  // 关联关系
  ownerId     Int
  owner       User     @relation("JobOwner", fields: [ownerId], references: [id])
  
  assignedAgentId Int?
  assignedAgent   Agent? @relation("AgentJobs", fields: [assignedAgentId], references: [id])
  
  // 执行信息
  startedAt   DateTime?
  completedAt DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  
  // 结果数据
  resultData  Json?
  feedback    String?  @db.Text
  rating      Int?     // 1-5 星评分
  
  // 关联记录
  recommendations JobAgentMatch[]
  applications    JobApplication[]
  
  // 其他
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([ownerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  
  // 第四阶段：Wallet 和 Bills
  transactions  Transaction[]
  bills         Bill[]
  
  // 第五阶段：DAO 争议解决
  disputes      Dispute[]
}

// Agent 匹配推荐
model JobAgentMatch {
  id          Int    @id @default(autoincrement())
  jobId       Int
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId     Int
  agent       Agent  @relation("AgentMatches", fields: [agentId], references: [id], onDelete: Cascade)
  
  matchScore  Float  // 匹配分数 0-100
  reason      String // 推荐理由
  
  createdAt   DateTime @default(now())
  
  @@unique([jobId, agentId])
  @@index([jobId])
  @@index([agentId])
}

// Agent 申请记录（可选功能，P1）
model JobApplication {
  id          Int    @id @default(autoincrement())
  jobId       Int
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId     Int
  agent       Agent  @relation("AgentApplications", fields: [agentId], references: [id], onDelete: Cascade)
  
  message     String? @db.Text
  proposedPrice Decimal? @db.Decimal(10, 2)
  estimatedTime Int? // 预计完成时间（分钟）
  status      ApplicationStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  
  @@unique([jobId, agentId])
  @@index([jobId])
  @@index([agentId])
  @@index([status])
}

// 申请状态
enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ============================================
// Wallet 和 Bills 模块（第四阶段）
// ============================================

// 交易类型枚举
enum TransactionType {
  JOB_PAYMENT       // Job 支付给 Agent
  PLATFORM_FEE      // 平台手续费
  REFUND            // 退款
  STAKING_REWARD    // 质押奖励
  WITHDRAWAL        // 提现
}

// 交易记录
model Transaction {
  id          Int      @id @default(autoincrement())
  
  type        TransactionType
  amount      Decimal  @db.Decimal(18, 6)
  currency    String   @default("ETH")
  
  // 关联
  fromUserId  Int?
  fromUser    User?    @relation("TransactionFrom", fields: [fromUserId], references: [id])
  toUserId    Int?
  toUser      User?    @relation("TransactionTo", fields: [toUserId], references: [id])
  
  jobId       Int?
  job         Job?     @relation(fields: [jobId], references: [id])
  
  // 链上信息
  txHash      String?  // 交易哈希
  blockNumber String?  // 区块号
  
  description String?  @db.Text
  metadata    Json?
  
  createdAt   DateTime @default(now())
  
  @@index([fromUserId])
  @@index([toUserId])
  @@index([jobId])
  @@index([type])
  @@index([createdAt])
}

// 账单类型
enum BillType {
  INCOME        // 收入账单（Agent 收到的）
  EXPENSE       // 支出账单（Job Owner 支付的）
  PLATFORM_FEE  // 平台费用账单
}

// 账单模型
model Bill {
  id          Int      @id @default(autoincrement())
  
  billNumber  String   @unique  // 账单编号（自动生成）
  type        BillType
  amount      Decimal  @db.Decimal(18, 6)
  currency    String   @default("ETH")
  
  // 关联
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  jobId       Int?
  job         Job?     @relation(fields: [jobId], references: [id])
  
  // 账单详情
  description String   @db.Text
  details     Json?    // 详细条目
  
  // 状态
  isPaid      Boolean  @default(true)  // 支付状态
  paidAt      DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([jobId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// DAO 争议解决模块（第五阶段）
// ============================================

// 争议状态
enum DisputeStatus {
  PENDING      // 待投票
  VOTING       // 投票中
  RESOLVED     // 已解决
  EXPIRED      // 已过期
}

// 投票选项
enum VoteChoice {
  APPROVE      // 支持（认可工作成果）
  REJECT       // 反对（认为工作不达标）
  ABSTAIN      // 弃权
}

// 争议模型
model Dispute {
  id              Int            @id @default(autoincrement())
  
  // 关联任务
  jobId           Int
  job             Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // 创建者
  creatorId       Int
  creator         User           @relation("DisputeCreator", fields: [creatorId], references: [id])
  
  // 争议内容
  title           String         // 争议标题
  reason          String         @db.Text
  evidence        String?        @db.Text  // 证据链接或描述
  
  // 状态和时间
  status          DisputeStatus  @default(PENDING)
  votingStartsAt  DateTime?
  votingEndsAt    DateTime?
  
  // 投票统计（冗余字段，用于快速查询）
  approveVotes    Int            @default(0)
  rejectVotes     Int            @default(0)
  abstainVotes    Int            @default(0)
  totalVoteWeight String         @default("0")  // 总投票权重（代币数量字符串）
  
  // 决议结果
  resolution      String?        @db.Text
  resolvedAt      DateTime?
  
  // 链上信息（预留）
  chainDisputeId  String?        @unique
  chainTxHash     String?
  
  // 关联投票
  votes           Vote[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@index([jobId])
  @@index([creatorId])
  @@index([status])
  @@index([createdAt])
}

// 投票记录
model Vote {
  id          Int         @id @default(autoincrement())
  
  // 关联争议
  disputeId   Int
  dispute     Dispute     @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  
  // 投票人
  voterId     Int
  voter       User        @relation(fields: [voterId], references: [id])
  
  // 投票内容
  choice      VoteChoice
  tokenWeight String      @default("0")  // 投票权重（代币数量，字符串存储）
  reason      String?     @db.Text
  
  // 链上信息（预留）
  txHash      String?     // 链上交易哈希
  
  createdAt   DateTime    @default(now())
  
  @@unique([disputeId, voterId])  // 一个用户对一个争议只能投一次票
  @@index([disputeId])
  @@index([voterId])
  @@index([createdAt])
  posts         Post[]
  agents        Agent[]
}

// Agent 模型
model Agent {
  id              Int      @id @default(autoincrement())
  userId          Int
  title           String
  description     String
  category        String
  subcategory     String?
  location        Json
  locationCity    String
  locationCountry String
  isRemote        Boolean
  services        Json
  pricing         Json
  availability    Json
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  completedJobs   Int      @default(0)
  responseTime    String
  languages       String[]
  tags            String[]
  isActive        Boolean  @default(true)
  minPrice        Float?
  maxPrice        Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([userId])
  @@index([isActive])
  @@index([minPrice])
  @@index([maxPrice])
  @@index([rating])
}

// Post 模型
model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
