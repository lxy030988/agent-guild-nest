// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User 模型 - 支持 Web3 登录
model User {
  id            Int      @id @default(autoincrement())
  walletAddress String   @unique // 钱包地址（主要登录凭证）
  email         String?  // 可选邮箱
  name          String?  // 用户名
  nonce         String?  // 用于签名验证的随机数
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  posts         Post[]
  agents        Agent[]  // 拥有的 Agents
  publishedJobs Job[]    @relation("JobOwner") // 发布的 Jobs（第三阶段）
}

// Post 模型
model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ============================================
// Agent 管理模块（第二阶段）
// ============================================

// Agent 分类枚举
enum AgentCategory {
  PRODUCTIVITY_TOOLS
  CREATIVE_ASSISTANTS
  DEVELOPER_TOOLS
  OTHERS
}

// Agent 状态
enum AgentStatus {
  DRAFT       // 草稿（第二阶段）
  ACTIVE      // 已发布（第二阶段）
  MINTED      // 已铸造 NFT（第四阶段）
  PAUSED      // 已暂停
  ARCHIVED    // 已归档
}

// Agent 主模型
model Agent {
  id            Int            @id @default(autoincrement())
  name          String
  description   String         @db.Text
  shortDesc     String?        // 简短描述（用于卡片展示）
  avatar        String?        // 头像 URL
  category      AgentCategory  @default(OTHERS)
  tags          String[]       // 标签数组
  status        AgentStatus    @default(DRAFT)
  
  // 能力和配置（第二阶段）
  capabilities  String[]       // 能力列表
  configuration Json?          // 配置 JSON
  
  // Agent 端点配置（第二阶段）
  endpointUrl       String        // API 端点 URL
  endpointAuthType  String        @default("public")  // bearer | api-key | public
  healthCheckUrl    String?       // 健康检查端点
  timeoutMs         Int           @default(30000)     // 超时时间（ms）
  
  // 安全（可选，public 类型不需要）
  secretKey         String?       @unique  // 加密存储，仅 bearer/api-key 类型需要
  
  // 规范定义（可选）
  inputSchema       Json?         // JSON Schema
  outputSchema      Json?         // JSON Schema
  
  // 统计信息（第二阶段）
  viewCount     Int            @default(0)
  reviewCount   Int            @default(0)  // 评价数
  jobCount      Int            @default(0)  // 完成的任务数
  rating        Float?         // 评分（1-5）
  
  // 验证状态（第二阶段）
  isVerified        Boolean       @default(false)     // 是否通过验证
  lastHealthCheck   DateTime?     // 最后健康检查时间
  healthStatus      String        @default("UNKNOWN") // HEALTHY | UNHEALTHY | UNKNOWN
  
  // 第三阶段预留字段（Jobs 市场）
  minPrice      Decimal?       @db.Decimal(18, 6)  // 最低价格（USDC）
  maxPrice      Decimal?       @db.Decimal(18, 6)  // 最高价格（USDC）
  availability  Boolean        @default(true)       // 是否可接任务
  
  // 第四阶段预留字段（NFT 和财务）
  tokenId           String?    @unique
  contractAddress   String?
  metadataURI       String?    // IPFS 元数据 URI
  totalEarnings     Decimal?   @default(0) @db.Decimal(18, 6)  // 累计收益（镜像链上）
  pendingEarnings   Decimal?   @default(0) @db.Decimal(18, 6)  // 待结算收益
  revenueShareBps   Int?       // 收益分配基点（10000 = 100%）
  stakedAmount      Decimal?   @default(0) @db.Decimal(18, 6)  // 质押金额
  lastSyncedAt      DateTime?  // 最后同步链上数据时间
  
  // 关联关系
  ownerId       Int
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // 第三阶段：与 Jobs 的关联
  jobs          Job[]          @relation("AgentJobs")
  matches       JobAgentMatch[] @relation("AgentMatches")
  applications  JobApplication[] @relation("AgentApplications")
  
  // 第五阶段：统计数据
  // dailyStats    AgentDailyStats[]
  
  // 时间戳
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // 索引
  @@index([category])
  @@index([ownerId])
  @@index([status])
  @@index([availability])  // 第三阶段查询可用 Agents
  @@index([tokenId])       // 第四阶段链上同步
  @@index([contractAddress])
  @@index([rating])        // 排行榜查询
  @@index([isVerified])    // 查询已验证的 Agents
}

// ============================================
// Jobs 市场模块（第三阶段）
// ============================================

// Job 分类枚举
enum JobCategory {
  CODE_REVIEW
  CONTENT_CREATION
  DATA_ANALYSIS
  TRANSLATION
  TESTING
  RESEARCH
  OTHER
}

// Job 状态
enum JobStatus {
  OPEN           // 待匹配
  MATCHED        // 已匹配 Agent
  IN_PROGRESS    // 执行中
  SUBMITTED      // 已提交结果
  COMPLETED      // 已完成
  CANCELLED      // 已取消
  DISPUTED       // 有争议（第五阶段）
}

// Job 匹配模式
enum MatchingMode {
  SMART         // 智能匹配（自动分配）
  MANUAL        // 手动选择（从推荐中选）
  APPLICATION   // 申请制（Agent 主动申请）
  OPEN_MARKET   // 开放市场（推荐 + 申请）
}

// Job 主模型
model Job {
  id          Int      @id @default(autoincrement())
  
  // 基本信息
  title       String
  description String   @db.Text
  category    JobCategory
  tags        String[]
  
  // 需求定义
  requiredCapabilities String[] // 需要的 Agent 能力
  inputData   Json                // 任务输入数据
  expectedOutput String? @db.Text // 期望输出说明
  
  // 财务信息
  budget      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USDC")
  escrowAmount Decimal @db.Decimal(10, 2) // 托管金额（预留第四阶段）
  
  // 时间信息
  deadline    DateTime?
  estimatedDuration Int? // 预计耗时（分钟）
  
  // 状态管理
  status      JobStatus @default(OPEN)
  matchingMode MatchingMode @default(SMART) // 匹配模式
  
  // 智能合约集成（链上字段）
  chainJobId      String?  @unique // 链上任务 ID（字符串存储，避免 BigInt 序列化问题）
  chainTxHash     String?           // 创建任务的交易哈希
  chainDeadline   String?           // 链上截止时间（Unix 时间戳，字符串存储）
  chainStatus     Int?              // 链上状态（用于对账）
  chainBudget     String?           // 链上托管金额（Wei，字符串存储）
  
  // 关联关系
  ownerId     Int
  owner       User     @relation("JobOwner", fields: [ownerId], references: [id])
  
  assignedAgentId Int?
  assignedAgent   Agent? @relation("AgentJobs", fields: [assignedAgentId], references: [id])
  
  // 执行信息
  startedAt   DateTime?
  completedAt DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  
  // 结果数据
  resultData  Json?
  feedback    String?  @db.Text
  rating      Int?     // 1-5 星评分
  
  // 关联记录
  recommendations JobAgentMatch[]
  applications    JobApplication[]
  
  // 其他
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([ownerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// Agent 匹配推荐
model JobAgentMatch {
  id          Int    @id @default(autoincrement())
  jobId       Int
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId     Int
  agent       Agent  @relation("AgentMatches", fields: [agentId], references: [id], onDelete: Cascade)
  
  matchScore  Float  // 匹配分数 0-100
  reason      String // 推荐理由
  
  createdAt   DateTime @default(now())
  
  @@unique([jobId, agentId])
  @@index([jobId])
  @@index([agentId])
}

// Agent 申请记录（可选功能，P1）
model JobApplication {
  id          Int    @id @default(autoincrement())
  jobId       Int
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId     Int
  agent       Agent  @relation("AgentApplications", fields: [agentId], references: [id], onDelete: Cascade)
  
  message     String? @db.Text
  proposedPrice Decimal? @db.Decimal(10, 2)
  estimatedTime Int? // 预计完成时间（分钟）
  status      ApplicationStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  
  @@unique([jobId, agentId])
  @@index([jobId])
  @@index([agentId])
  @@index([status])
}

// 申请状态
enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}
