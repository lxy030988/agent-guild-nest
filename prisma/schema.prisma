// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User 模型 - 支持 Web3 登录
model User {
  id            Int      @id @default(autoincrement())
  walletAddress String   @unique // 钱包地址（主要登录凭证）
  email         String?  // 可选邮箱
  name          String?  // 用户名
  nonce         String?  // 用于签名验证的随机数
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agents        Agent[]  // 拥有的 Agents
  publishedJobs Job[]    @relation("JobOwner") // 发布的 Jobs（第三阶段）
  
  // 第四阶段：Wallet 和 Bills
  transactionsFrom  Transaction[] @relation("TransactionFrom")
  transactionsTo    Transaction[] @relation("TransactionTo")
  bills             Bill[]
  
  // 第五阶段：DAO 争议解决
  createdDisputes   Dispute[]     @relation("DisputeCreator")  // 创建的争议
  votes             Vote[]        // 投票记录
}



// ============================================
// Agent 管理模块（第二阶段）
// ============================================

// Agent 分类枚举
enum AgentCategory {
  PRODUCTIVITY_TOOLS
  CREATIVE_ASSISTANTS
  DEVELOPER_TOOLS
  OTHERS
}

// Agent 状态
enum AgentStatus {
  DRAFT       // 草稿（第二阶段）
  ACTIVE      // 已发布（第二阶段）
  MINTED      // 已铸造 NFT（第四阶段）
  PAUSED      // 已暂停
  ARCHIVED    // 已归档
}

// Agent 主模型
model Agent {
  id            Int            @id @default(autoincrement())
  name          String
  description   String         @db.Text
  shortDesc     String?        // 简短描述（用于卡片展示）
  avatar        String?        // 头像 URL
  category      AgentCategory  @default(OTHERS)
  tags          String[]       // 标签数组
  status        AgentStatus    @default(DRAFT)
  
  // 能力和配置（第二阶段）
  capabilities  String[]       // 能力列表
  configuration Json?          // 配置 JSON
  
  // Agent 端点配置（第二阶段）
  endpointUrl       String        // API 端点 URL
  endpointAuthType  String        @default("public")  // bearer | api-key | public
  healthCheckUrl    String?       // 健康检查端点
  timeoutMs         Int           @default(30000)     // 超时时间（ms）
  
  // 安全（可选，public 类型不需要）
  secretKey         String?       @unique  // 加密存储，仅 bearer/api-key 类型需要
  
  // 规范定义（可选）
  inputSchema       Json?         // JSON Schema
  outputSchema      Json?         // JSON Schema
  
  // 统计信息（第二阶段）
  viewCount     Int            @default(0)
  reviewCount   Int            @default(0)  // 评价数
  jobCount      Int            @default(0)  // 完成的任务数
  rating        Float?         // 评分（1-5）
  
  // 验证状态（第二阶段）
  isVerified        Boolean       @default(false)     // 是否通过验证
  lastHealthCheck   DateTime?     // 最后健康检查时间
  healthStatus      String        @default("UNKNOWN") // HEALTHY | UNHEALTHY | UNKNOWN
  
  // 第三阶段预留字段（Jobs 市场）
  minPrice      Decimal?       @db.Decimal(18, 6)  // 最低价格（USDC）
  maxPrice      Decimal?       @db.Decimal(18, 6)  // 最高价格（USDC）
  availability  Boolean        @default(true)       // 是否可接任务
  
  // 第四阶段预留字段（NFT 和财务）
  tokenId           String?    @unique
  contractAddress   String?
  metadataURI       String?    // IPFS 元数据 URI
  totalEarnings     Decimal?   @default(0) @db.Decimal(18, 6)  // 累计收益（镜像链上）
  pendingEarnings   Decimal?   @default(0) @db.Decimal(18, 6)  // 待结算收益
  revenueShareBps   Int?       // 收益分配基点（10000 = 100%）
  stakedAmount      Decimal?   @default(0) @db.Decimal(18, 6)  // 质押金额
  lastSyncedAt      DateTime?  // 最后同步链上数据时间
  
  // 关联关系
  ownerId       Int
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // 第三阶段：与 Jobs 的关联
  jobs          Job[]          @relation("AgentJobs")
  matches       JobAgentMatch[] @relation("AgentMatches")
  applications  JobApplication[] @relation("AgentApplications")
  
  // 第五阶段：统计数据
  // dailyStats    AgentDailyStats[]
  
  // 时间戳
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // 索引
  @@index([category])
  @@index([ownerId])
  @@index([status])
  @@index([availability])  // 第三阶段查询可用 Agents
  @@index([tokenId])       // 第四阶段链上同步
  @@index([contractAddress])
  @@index([rating])        // 排行榜查询
  @@index([isVerified])    // 查询已验证的 Agents
}

// ============================================
// Jobs 市场模块（第三阶段）
// ============================================

// Job 分类枚举
enum JobCategory {
  CODE_REVIEW
  CONTENT_CREATION
  DATA_ANALYSIS
  TRANSLATION
  TESTING
  RESEARCH
  OTHER
}

// Job 状态
enum JobStatus {
  OPEN           // 待匹配
  MATCHED        // 已匹配 Agent
  IN_PROGRESS    // 执行中
  SUBMITTED      // 已提交结果
  COMPLETED      // 已完成
  CANCELLED      // 已取消
  DISPUTED       // 有争议（第五阶段）
  RESOLVED_COMPLETED // 争议解决-已支付
  RESOLVED_CANCELLED // 争议解决-已退款
}

// Job 匹配模式
enum MatchingMode {
  SMART         // 智能匹配（自动分配）
  MANUAL        // 手动选择（从推荐中选）
  APPLICATION   // 申请制（Agent 主动申请）
  OPEN_MARKET   // 开放市场（推荐 + 申请）
}

// Job 主模型
model Job {
  id          Int      @id @default(autoincrement())
  
  // 基本信息
  title       String
  description String   @db.Text
  category    JobCategory
  tags        String[]
  
  // 需求定义
  requiredCapabilities String[] // 需要的 Agent 能力
  inputData   Json                // 任务输入数据
  expectedOutput String? @db.Text // 期望输出说明
  
  // 财务信息
  budget      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USDC")
  escrowAmount Decimal @db.Decimal(10, 2) // 托管金额（预留第四阶段）
  
  // 时间信息
  deadline    DateTime?
  estimatedDuration Int? // 预计耗时（分钟）
  
  // 状态管理
  status      JobStatus @default(OPEN)
  matchingMode MatchingMode @default(SMART) // 匹配模式
  
  // 智能合约集成（链上字段）
  chainJobId      String?  @unique // 链上任务 ID（字符串存储，避免 BigInt 序列化问题）
  chainTxHash     String?           // 创建任务的交易哈希
  chainDeadline   String?           // 链上截止时间（Unix 时间戳，字符串存储）
  chainStatus     Int?              // 链上状态（用于对账）
  chainBudget     String?           // 链上托管金额（Wei，字符串存储）
  
  // 关联关系
  ownerId     Int
  owner       User     @relation("JobOwner", fields: [ownerId], references: [id])
  
  assignedAgentId Int?
  assignedAgent   Agent? @relation("AgentJobs", fields: [assignedAgentId], references: [id])
  
  // 执行信息
  startedAt   DateTime?
  completedAt DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  
  // 结果数据
  resultData  Json?
  feedback    String?  @db.Text
  rating      Int?     // 1-5 星评分
  
  // 关联记录
  recommendations JobAgentMatch[]
  applications    JobApplication[]
  
  // 其他
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([ownerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  
  // 第四阶段：Wallet 和 Bills
  transactions  Transaction[]
  bills         Bill[]
  
  // 第五阶段：DAO 争议解决
  disputes      Dispute[]
}

// Agent 匹配推荐
model JobAgentMatch {
  id          Int    @id @default(autoincrement())
  jobId       Int
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId     Int
  agent       Agent  @relation("AgentMatches", fields: [agentId], references: [id], onDelete: Cascade)
  
  matchScore  Float  // 匹配分数 0-100
  reason      String // 推荐理由
  
  createdAt   DateTime @default(now())
  
  @@unique([jobId, agentId])
  @@index([jobId])
  @@index([agentId])
}

// Agent 申请记录（可选功能，P1）
model JobApplication {
  id          Int    @id @default(autoincrement())
  jobId       Int
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId     Int
  agent       Agent  @relation("AgentApplications", fields: [agentId], references: [id], onDelete: Cascade)
  
  message     String? @db.Text
  proposedPrice Decimal? @db.Decimal(10, 2)
  estimatedTime Int? // 预计完成时间（分钟）
  status      ApplicationStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  
  @@unique([jobId, agentId])
  @@index([jobId])
  @@index([agentId])
  @@index([status])
}

// 申请状态
enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ============================================
// Wallet 和 Bills 模块（第四阶段）
// ============================================

// 交易类型枚举
enum TransactionType {
  JOB_PAYMENT       // Job 支付给 Agent
  PLATFORM_FEE      // 平台手续费
  REFUND            // 退款
  STAKING_REWARD    // 质押奖励
  WITHDRAWAL        // 提现
}

// 交易记录
model Transaction {
  id          Int      @id @default(autoincrement())
  
  type        TransactionType
  amount      Decimal  @db.Decimal(18, 6)
  currency    String   @default("ETH")
  
  // 关联
  fromUserId  Int?
  fromUser    User?    @relation("TransactionFrom", fields: [fromUserId], references: [id])
  toUserId    Int?
  toUser      User?    @relation("TransactionTo", fields: [toUserId], references: [id])
  
  jobId       Int?
  job         Job?     @relation(fields: [jobId], references: [id])
  
  // 链上信息
  txHash      String?  // 交易哈希
  blockNumber String?  // 区块号
  
  description String?  @db.Text
  metadata    Json?
  
  createdAt   DateTime @default(now())
  
  @@index([fromUserId])
  @@index([toUserId])
  @@index([jobId])
  @@index([type])
  @@index([createdAt])
}

// 账单类型
enum BillType {
  INCOME        // 收入账单（Agent 收到的）
  EXPENSE       // 支出账单（Job Owner 支付的）
  PLATFORM_FEE  // 平台费用账单
}

// 账单模型
model Bill {
  id          Int      @id @default(autoincrement())
  
  billNumber  String   @unique  // 账单编号（自动生成）
  type        BillType
  amount      Decimal  @db.Decimal(18, 6)
  currency    String   @default("ETH")
  
  // 关联
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  jobId       Int?
  job         Job?     @relation(fields: [jobId], references: [id])
  
  // 账单详情
  description String   @db.Text
  details     Json?    // 详细条目
  
  // 状态
  isPaid      Boolean  @default(true)  // 支付状态
  paidAt      DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([jobId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// DAO 争议解决模块（第五阶段）
// ============================================

// 争议状态
enum DisputeStatus {
  PENDING      // 待投票
  VOTING       // 投票中
  RESOLVED     // 已解决
  EXPIRED      // 已过期
}

// 投票选项
enum VoteChoice {
  APPROVE      // 支持（认可工作成果）
  REJECT       // 反对（认为工作不达标）
  ABSTAIN      // 弃权
}

// 争议模型
model Dispute {
  id              Int            @id @default(autoincrement())
  
  // 关联任务
  jobId           Int
  job             Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // 创建者
  creatorId       Int
  creator         User           @relation("DisputeCreator", fields: [creatorId], references: [id])
  
  // 争议内容
  title           String         // 争议标题
  reason          String         @db.Text
  evidence        String?        @db.Text  // 证据链接或描述
  
  // 状态和时间
  status          DisputeStatus  @default(PENDING)
  votingStartsAt  DateTime?
  votingEndsAt    DateTime?
  
  // 投票统计（冗余字段，用于快速查询）
  approveVotes    Int            @default(0)
  rejectVotes     Int            @default(0)
  abstainVotes    Int            @default(0)
  totalVoteWeight String         @default("0")  // 总投票权重（代币数量字符串）
  
  // 决议结果
  resolution      String?        @db.Text
  resolvedAt      DateTime?
  
  // 链上信息（预留）
  chainDisputeId  String?        @unique
  chainTxHash     String?
  
  // 关联投票
  votes           Vote[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  @@index([jobId])
  @@index([creatorId])
  @@index([status])
  @@index([createdAt])
}

// 投票记录
model Vote {
  id          Int         @id @default(autoincrement())
  
  // 关联争议
  disputeId   Int
  dispute     Dispute     @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  
  // 投票人
  voterId     Int
  voter       User        @relation(fields: [voterId], references: [id])
  
  // 投票内容
  choice      VoteChoice
  tokenWeight String      @default("0")  // 投票权重（代币数量，字符串存储）
  reason      String?     @db.Text
  
  // 链上信息（预留）
  txHash      String?     // 链上交易哈希
  
  createdAt   DateTime    @default(now())
  
  @@unique([disputeId, voterId])  // 一个用户对一个争议只能投一次票
  @@index([disputeId])
  @@index([voterId])
  @@index([createdAt])
}

// ==================== DAO Governance Models ====================

// Enums
enum ProposalStatus {
  PENDING
  ACTIVE
  CANCELED
  DEFEATED
  SUCCEEDED
  QUEUED
  EXPIRED
  EXECUTED
}

enum VoteType {
  FOR
  AGAINST
  ABSTAIN
}

enum AssetType {
  NATIVE
  ERC20
  ERC721
  ERC1155
}

enum ActivityType {
  PROPOSAL_CREATED
  PROPOSAL_CANCELED
  PROPOSAL_EXECUTED
  VOTE_CAST
  STAKE_CREATED
  STAKE_WITHDRAWN
  DELEGATION_CHANGED
}

// Proposal 模型 - DAO 提案
model Proposal {
  id                    String                 @id @default(uuid())
  proposalId            BigInt                 @unique // 链上提案 ID
  title                 String
  description           String                 @db.Text
  proposer              String                 // 提案者钱包地址
  status                ProposalStatus         @default(PENDING)

  // Vote counts
  votesFor              BigInt                 @default(0)
  votesAgainst          BigInt                 @default(0)
  votesAbstain          BigInt                 @default(0)

  // Blockchain data
  transactionHash       String
  blockNumber           BigInt
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Voting period
  startBlock            BigInt
  endBlock              BigInt
  startTime             DateTime?
  endTime               DateTime?

  // Governance parameters
  quorumReached         Boolean                @default(false)
  executed              Boolean                @default(false)
  canceled              Boolean                @default(false)
  executedAt            DateTime?
  canceledAt            DateTime?
  executionTransactionHash String?

  // Relations
  votes                 Vote[]
  transactions          ProposalTransaction[]

  @@index([proposer])
  @@index([status])
  @@index([createdAt])
  @@index([endTime])
}

// Vote 模型 - 投票记录
model Vote {
  id                    String                 @id @default(uuid())
  proposalId            String
  voter                 String                 // 投票者钱包地址
  support               VoteType               // 投票类型
  votingPower           BigInt                 // 投票权重
  reason                String?                @db.Text

  // Blockchain data
  transactionHash       String
  blockNumber           BigInt
  timestamp             DateTime               @default(now())

  // Relation
  proposal              Proposal               @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, voter])
  @@index([voter])
  @@index([proposalId])
  @@index([timestamp])
}

// ProposalTransaction 模型 - 提案执行的交易
model ProposalTransaction {
  id                    String                 @id @default(uuid())
  proposalId            String
  target                String                 // 目标合约地址
  value                 BigInt                 @default(0) // ETH 金额
  calldata              String                 @db.Text // 调用数据
  description           String?                @db.Text
  executed              Boolean                @default(false)
  executedAt            DateTime?
  transactionHash       String?

  // Relation
  proposal              Proposal               @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

// Stake 模型 - 质押记录
model Stake {
  id                    String                 @id @default(uuid())
  walletAddress         String                 // 质押者钱包地址
  amount                BigInt                 // 质押数量
  lockPeriod            Int                    // 锁定期（秒）
  multiplier            Float                  @default(1.0) // 投票权乘数

  // Timestamps
  stakedAt              DateTime               @default(now())
  unlockAt              DateTime               // 解锁时间
  withdrawnAt           DateTime?

  // Blockchain data
  transactionHash       String
  blockNumber           BigInt

  // Withdrawal
  withdrawn             Boolean                @default(false)
  withdrawTransactionHash String?

  @@index([walletAddress])
  @@index([unlockAt])
  @@index([withdrawn])
}

// Treasury 模型 - DAO 资金库
model Treasury {
  id                    String                 @id @default(uuid())
  assetType             AssetType
  tokenAddress          String?                // ERC20/ERC721/ERC1155 地址
  tokenId               BigInt?                // ERC721/ERC1155 ID
  balance               BigInt                 @default(0)

  // Metadata
  symbol                String?
  name                  String?
  decimals              Int?

  // Tracking
  lastUpdated           DateTime               @updatedAt
  createdAt             DateTime               @default(now())

  @@unique([assetType, tokenAddress, tokenId])
  @@index([assetType])
}

// GovernanceStats 模型 - 用户治理统计
model GovernanceStats {
  id                    String                 @id @default(uuid())
  walletAddress         String                 @unique

  // Proposal stats
  proposalsCreated      Int                    @default(0)
  proposalsExecuted     Int                    @default(0)
  proposalsCanceled     Int                    @default(0)

  // Voting stats
  totalVotes            Int                    @default(0)
  votesFor              Int                    @default(0)
  votesAgainst          Int                    @default(0)
  votesAbstain          Int                    @default(0)

  // Staking stats
  totalStaked           BigInt                 @default(0)
  currentStaked         BigInt                 @default(0)
  totalVotingPower      BigInt                 @default(0)

  // Activity
  lastActivityAt        DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([totalVotingPower])
  @@index([lastActivityAt])
}

// GovernanceActivity 模型 - 治理活动记录
model GovernanceActivity {
  id                    String                 @id @default(uuid())
  activityType          ActivityType
  walletAddress         String                 // 活动发起者

  // Reference IDs
  proposalId            String?
  voteId                String?
  stakeId               String?

  // Details
  description           String                 @db.Text
  metadata              String?                @db.Text // JSON 格式的额外数据

  // Blockchain data
  transactionHash       String?
  blockNumber           BigInt?
  timestamp             DateTime               @default(now())

  @@index([walletAddress])
  @@index([activityType])
  @@index([timestamp])
  @@index([proposalId])
}
