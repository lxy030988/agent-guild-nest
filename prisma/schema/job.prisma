// ============================================
// Jobs 市场模块（第三阶段）
// ============================================

// Job 分类枚举
enum JobCategory {
  CODE_REVIEW
  CONTENT_CREATION
  DATA_ANALYSIS
  TRANSLATION
  TESTING
  RESEARCH
  OTHER
}

// Job 状态
enum JobStatus {
  OPEN           // 待匹配
  MATCHED        // 已匹配 Agent
  IN_PROGRESS    // 执行中
  SUBMITTED      // 已提交结果
  COMPLETED      // 已完成
  CANCELLED      // 已取消
  DISPUTED       // 有争议（第五阶段）
  RESOLVED_COMPLETED // 争议解决-已支付
  RESOLVED_CANCELLED // 争议解决-已退款
}

// Job 匹配模式
enum MatchingMode {
  SMART         // 智能匹配（自动分配）
  MANUAL        // 手动选择（从推荐中选）
  APPLICATION   // 申请制（Agent 主动申请）
  OPEN_MARKET   // 开放市场（推荐 + 申请）
}

// Job 主模型
model Job {
  id          Int      @id @default(autoincrement())
  
  // 基本信息
  title       String
  description String   @db.Text
  category    JobCategory
  tags        String[]
  
  // 需求定义
  requiredCapabilities String[] // 需要的 Agent 能力
  inputData   Json                // 任务输入数据
  expectedOutput String? @db.Text // 期望输出说明
  
  // 财务信息
  budget      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USDC")
  escrowAmount Decimal @db.Decimal(10, 2) // 托管金额（预留第四阶段）
  
  // 时间信息
  deadline    DateTime?
  estimatedDuration Int? // 预计耗时（分钟）
  
  // 状态管理
  status      JobStatus @default(OPEN)
  matchingMode MatchingMode @default(SMART) // 匹配模式
  
  // 智能合约集成（链上字段）
  chainJobId      String?  @unique // 链上任务 ID（字符串存储，避免 BigInt 序列化问题）
  chainTxHash     String?           // 创建任务的交易哈希
  chainDeadline   String?           // 链上截止时间（Unix 时间戳，字符串存储）
  chainStatus     Int?              // 链上状态（用于对账）
  chainBudget     String?           // 链上托管金额（Wei，字符串存储）
  
  // 关联关系
  ownerId     Int
  owner       User     @relation("JobOwner", fields: [ownerId], references: [id])
  
  assignedAgentId Int?
  assignedAgent   Agent? @relation("AgentJobs", fields: [assignedAgentId], references: [id])
  
  // 🆕 竞价模式字段
  competitionMode    Boolean  @default(false)        // 是否启用竞价模式
  competitorCount    Int      @default(3)            // 竞争 Agent 数量（2-5）
  
  // 🆕 多个执行记录
  executions         JobExecution[]                  // 所有参与竞价的 Agent 执行记录
  
  // 🆕 胜出者信息
  winnerExecutionId  Int?                            // 胜出的执行记录 ID
  winnerExecution    JobExecution? @relation("WinnerExecution", fields: [winnerExecutionId], references: [id])
  
  // 执行信息
  startedAt   DateTime?
  completedAt DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  
  // 结果数据
  resultData  Json?
  feedback    String?  @db.Text
  rating      Int?     // 1-5 星评分
  
  // 关联记录
  recommendations JobAgentMatch[]
  applications    JobApplication[]
  
  // 其他
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([ownerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  
  // 第四阶段：Wallet 和 Bills
  transactions  Transaction[]
  bills         Bill[]
  
  // 第五阶段：DAO 争议解决
  disputes      Dispute[]
}

// Agent 匹配推荐
model JobAgentMatch {
  id          Int    @id @default(autoincrement())
  jobId       Int
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId     Int
  agent       Agent  @relation("AgentMatches", fields: [agentId], references: [id], onDelete: Cascade)
  
  matchScore  Float  // 匹配分数 0-100
  reason      String // 推荐理由
  
  createdAt   DateTime @default(now())
  
  @@unique([jobId, agentId])
  @@index([jobId])
  @@index([agentId])
}

// Agent 申请记录（可选功能，P1）
model JobApplication {
  id          Int    @id @default(autoincrement())
  jobId       Int
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId     Int
  agent       Agent  @relation("AgentApplications", fields: [agentId], references: [id], onDelete: Cascade)
  
  message     String? @db.Text
  proposedPrice Decimal? @db.Decimal(10, 2)
  estimatedTime Int? // 预计完成时间（分钟）
  status      ApplicationStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  
  @@unique([jobId, agentId])
  @@index([jobId])
  @@index([agentId])
  @@index([status])
}

// 申请状态
enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}
