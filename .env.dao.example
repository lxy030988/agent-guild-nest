# DAO Module Environment Variables
# Copy these to your .env file

# ====================================
# Blockchain Configuration
# ====================================

# Chain ID
# 1 = Ethereum Mainnet
# 11155111 = Sepolia Testnet
# 5 = Goerli Testnet (deprecated)
CHAIN_ID=1

# RPC URL
# Public RPCs (free but rate-limited):
RPC_URL=https://eth.llamarpc.com
# RPC_URL=https://rpc.sepolia.org
# RPC_URL=https://ethereum-sepolia.publicnode.com

# With Alchemy (recommended for production):
# RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# With Infura:
# RPC_URL=https://mainnet.infura.io/v3/YOUR_API_KEY
# RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY

# ====================================
# Smart Contract Addresses
# ====================================

# Governor Contract (OpenZeppelin Governor)
# This is the main governance contract that handles proposals and voting
GOVERNOR_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Token Contract (ERC20Votes or similar)
# This is the governance token used for voting power
TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Staking Contract (if using separate staking)
# This contract manages token staking for voting power multipliers
STAKING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Treasury Contract
# This is the DAO treasury contract for managing funds
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Governance Token Address (for event listening)
GOVERNANCE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# ====================================
# Event Indexing Configuration
# ====================================

# Starting block for event indexing (deployment block)
# Set this to the block number where your contracts were deployed
# This reduces indexing time by not scanning the entire blockchain
START_BLOCK=0

# Blockchain RPC URL (for event listening)
# Same as RPC_URL above, but explicitly named for clarity
BLOCKCHAIN_RPC_URL=https://eth.llamarpc.com

# ====================================
# Optional: Write Operations
# ====================================

# Private Key (for signing transactions from backend)
# Leave empty if you only need read operations
# WARNING: Never commit this to version control!
PRIVATE_KEY=

# ====================================
# Example Configurations
# ====================================

# Example 1: Ethereum Mainnet with Alchemy
# CHAIN_ID=1
# RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# BLOCKCHAIN_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# GOVERNOR_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
# TOKEN_CONTRACT_ADDRESS=0x2345678901234567890123456789012345678901
# STAKING_CONTRACT_ADDRESS=0x3456789012345678901234567890123456789012
# TREASURY_ADDRESS=0x4567890123456789012345678901234567890123
# GOVERNANCE_TOKEN_ADDRESS=0x2345678901234567890123456789012345678901
# START_BLOCK=18500000

# Example 2: Sepolia Testnet with Public RPC
# CHAIN_ID=11155111
# RPC_URL=https://rpc.sepolia.org
# BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
# GOVERNOR_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
# TOKEN_CONTRACT_ADDRESS=0x2345678901234567890123456789012345678901
# STAKING_CONTRACT_ADDRESS=0x3456789012345678901234567890123456789012
# TREASURY_ADDRESS=0x4567890123456789012345678901234567890123
# GOVERNANCE_TOKEN_ADDRESS=0x2345678901234567890123456789012345678901
# START_BLOCK=4500000

# ====================================
# Notes
# ====================================

# 1. Contract addresses must be valid Ethereum addresses (42 characters starting with 0x)
# 2. If you don't have a staking contract, you can use the same address as the token contract
# 3. For development, you can use testnet addresses from your test deployments
# 4. For production, ensure you're using the correct mainnet addresses
# 5. Never share or commit your PRIVATE_KEY
# 6. START_BLOCK should be set to the deployment block to optimize indexing performance
# 7. The event listener will automatically index historical events on startup
# 8. Real-time event listening starts after historical indexing completes
# 9. For high-volume chains, consider using a dedicated RPC endpoint (Alchemy, Infura, etc.)
# 10. The indexer processes events in batches of 10,000 blocks to avoid RPC timeouts
